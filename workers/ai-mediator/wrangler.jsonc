{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hemmakompassen-ai-medlare",
  "main": "./src/index.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "vars": {
    "APP_ORIGIN": "https://erikjarl.github.io"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "LIMITS",
      "database_name": "hemmakompassen-ai-limits",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ]
}
